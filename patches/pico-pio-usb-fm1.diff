diff --git a/src/pio_usb_host.c b/src/pio_usb_host.c
index 7c18e5f..4ecba17 100644
--- a/src/pio_usb_host.c
+++ b/src/pio_usb_host.c
@@ -219,11 +219,27 @@ static void __not_in_flash_func(busy_wait_1_us)(void) {
   }
 }
 
+// FM-1 test: debounce disconnect over several frames (JieLi devices drop D+ briefly after reset).
+#define FM1_DISCONNECT_FRAMES 20
+static uint8_t fm1_se0_frames[PIO_USB_ROOT_PORT_CNT];
+// FM-1 test: also notice a device that vanishes while the port waits for its bus reset.
+static uint8_t fm1_idle_se0_frames[PIO_USB_ROOT_PORT_CNT];
+static volatile bool fm1_in_reset[PIO_USB_ROOT_PORT_CNT];
+
 static bool __no_inline_not_in_flash_func(connection_check)(root_port_t *port) {
+  uint8_t const fm1_idx = port - PIO_USB_ROOT_PORT(0);
+  if (pio_usb_bus_get_line_state(port) != PORT_PIN_SE0) {
+    fm1_se0_frames[fm1_idx] = 0;
+  }
   if (pio_usb_bus_get_line_state(port) == PORT_PIN_SE0) {
     busy_wait_1_us();
 
+    if (pio_usb_bus_get_line_state(port) == PORT_PIN_SE0 &&
+        ++fm1_se0_frames[fm1_idx] < FM1_DISCONNECT_FRAMES) {
+      return false;  // skip this frame's SOF; not yet a disconnect
+    }
     if (pio_usb_bus_get_line_state(port) == PORT_PIN_SE0) {
+      fm1_se0_frames[fm1_idx] = 0;
       busy_wait_1_us();
       // device disconnect
       port->connected = false;
@@ -339,6 +355,16 @@ void __not_in_flash_func(pio_usb_host_frame)(void) {
         root->connected = true;
         root->suspended = true; // need a bus reset before operating
         root->ints |= PIO_USB_INTS_CONNECT_BITS;
+        fm1_idle_se0_frames[root_idx] = 0;
+      }
+    } else if (root->initialized && root->connected && root->suspended &&
+               !fm1_in_reset[root_idx]) {
+      if (pio_usb_bus_get_line_state(root) != PORT_PIN_SE0) {
+        fm1_idle_se0_frames[root_idx] = 0;
+      } else if (++fm1_idle_se0_frames[root_idx] >= FM1_DISCONNECT_FRAMES) {
+        fm1_idle_se0_frames[root_idx] = 0;
+        root->connected = false;
+        root->ints |= PIO_USB_INTS_DISCONNECT_BITS;
       }
     }
   }
@@ -381,6 +407,7 @@ void pio_usb_host_port_reset_start(uint8_t root_idx) {
 
   // bus is not operating while in reset
   root->suspended = true;
+  fm1_in_reset[root_idx] = true;
 
   // Force line state to SE0
   gpio_set_outover(root->pin_dp,  GPIO_OVERRIDE_LOW);
@@ -398,6 +425,7 @@ void pio_usb_host_port_reset_end(uint8_t root_idx) {
   gpio_set_outover(root->pin_dp,  GPIO_OVERRIDE_NORMAL);
   gpio_set_outover(root->pin_dm,  GPIO_OVERRIDE_NORMAL);
   busy_wait_us(100); // TODO check if this is neccessary
+  fm1_in_reset[root_idx] = false;
 
   // bus back to operating
   root->suspended = false;
