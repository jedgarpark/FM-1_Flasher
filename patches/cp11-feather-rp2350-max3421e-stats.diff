--- a/shared-module/max3421e/Max3421E.c
+++ b/shared-module/max3421e/Max3421E.c
@@ -22,6 +22,15 @@
 
 max3421e_max3421e_obj_t *_active;
 
+// FM-1 debug counters, read from Python through memorymap (device/fm1_max_stats.py).
+// [1] int handler with hirq, [2] FRAME, [3] CONDET, [4] RCVDAV, [5] HXFRDN,
+// [6] NAKs, [7] last NAK (addr << 8 | dir << 7 | ep), [8] NAKs on ep0,
+// [9] pin IRQs, [10] callback deferred (bus busy), [11] tuh_task runs,
+// [12] tuh_task deferred, [13] tuh_task max us, [14] tuh_task total us,
+// [15] CS lock failed, [16] delay_ms calls, [17] delay_ms total ms.
+// [18]-[22]: SPI lock holder and wait_for_lock timeouts (busio SPI.c).
+volatile uint32_t fm1_stats[24] = {0x464D3153};
+
 // Use CP's background callbacks to run the "interrupt" handler. The GPIO ISR
 // stack is too small to do the SPI transactions that the interrupt handler does.
 static background_callback_t tuh_callback;
@@ -84,6 +93,8 @@ void common_hal_max3421e_max3421e_deinit(max3421e_max3421e_obj_t *self) {
 // tuh_task() which is run as a background task.
 #if CFG_TUSB_OS == OPT_OS_NONE
 void tusb_time_delay_ms_api(uint32_t msec) {
+    fm1_stats[16]++;
+    fm1_stats[17] += msec;
     uint32_t end_time = common_hal_time_monotonic_ms() + msec;
     while (common_hal_time_monotonic_ms() < end_time) {
         if (tuh_callback.prev != NULL) {
@@ -102,6 +113,7 @@ static void tuh_interrupt_callback(void *data) {
         // calls RUN_BACKGROUND_TASKS.)
         if (!common_hal_busio_spi_try_lock(self->bus)) {
             // Come back to us.
+            fm1_stats[10]++;
             background_callback_add(&tuh_callback, tuh_interrupt_callback, (void *)self);
 
             return;
@@ -118,10 +130,29 @@ static void tuh_interrupt_callback(void *data) {
 void max3421e_interrupt_handler(max3421e_max3421e_obj_t *arg) {
     max3421e_max3421e_obj_t *self = (max3421e_max3421e_obj_t *)arg;
     // Schedule the CP background callback.
+    fm1_stats[9]++;
     background_callback_add(&tuh_callback, tuh_interrupt_callback, (void *)self);
     common_hal_max3421e_max3421e_irq_enabled(self, false);
 }
 
+// tuh_max3421_spi_cs_api() can't wait for a bus that a display refresh or an
+// SD card read holds (they run background tasks while holding it), so it skips
+// the transfer and TinyUSB acts on register values it never read: devices
+// don't enumerate, or the board hard faults. usb_background() asks this first
+// and runs tuh_task() later instead.
+bool max3421e_spi_busy(void) {
+    max3421e_max3421e_obj_t *self = _active;
+    if (self == NULL || common_hal_max3421e_max3421e_deinited(self) ||
+        common_hal_busio_spi_deinited(self->bus)) {
+        return false;
+    }
+    if (!common_hal_busio_spi_try_lock(self->bus)) {
+        return true;
+    }
+    common_hal_busio_spi_unlock(self->bus);
+    return false;
+}
